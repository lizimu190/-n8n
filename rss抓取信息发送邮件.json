    {
      "parameters": {
        "jsCode": "const newItems = [];\n\nfor (const item of $input.all()) {\n  try {\n    // 自动寻找 AI 的输出文本 (兼容 OpenAI 和常见大模型节点的默认字段)\n    let aiString = item.json.message?.content || item.json.text || item.json.output || \"\";\n    \n    // 强制转换为字符串并清理 Markdown 符号和两端空格\n    aiString = String(aiString).replace(/```json/g, '').replace(/```/g, '').trim();\n\n    // 解析你那段带有 \\n 的 JSON 数据\n    let aiData = JSON.parse(aiString);\n\n    // 重新拼装出干净的数据字典\n    newItems.push({\n      json: {\n        title: item.json.title || \"未知标题\",\n        link: item.json.link || \"\",\n        summary: aiData.summary,\n        score: Number(aiData.score),\n        reason: aiData.reason\n      }\n    });\n  } catch (error) {\n    // 遇到不规范的乱码数据，直接给 0 分并标记，防止工作流中断\n    newItems.push({\n      json: {\n        title: item.json.title || \"【数据异常】\",\n        link: item.json.link || \"\",\n        summary: \"AI 节点返回的数据格式错误，无法解析。\",\n        score: 0, \n        reason: \"解析失败\",\n        error_info: error.message\n      }\n    });\n  }\n}\n\nreturn newItems;"
      },
